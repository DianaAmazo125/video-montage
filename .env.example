# --- LLM для режима --ai (монтаж по смыслу ролика) ---
# Ключ ProxyAPI из личного кабинета https://proxyapi.ru
OPENAI_API_KEY=

# ВАЖНО: поддомен api. и суффикс /v1 в конце, иначе эндпоинт вернёт 404
OPENAI_BASE_URL=https://api.proxyapi.ru/v1

# Модель по умолчанию для флага --ai-model
OPENMONTAGE_AI_MODEL=deepseek/deepseek-chat
